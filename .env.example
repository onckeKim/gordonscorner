# ---------------------------------------------------------------------------
# Supabase (Database + Auth)
# Get these from your Supabase project: Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET — server-side only, never exposed to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Email (Resend) — leave RESEND_API_KEY unset to use the dev console adapter
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Gordon's Corner <bookings@gordonscorner.co.za>"
# Internal inbox that receives new-request / deposit-confirmed notifications.
ADMIN_NOTIFICATION_EMAIL=admin@gordonscorner.co.za

# ---------------------------------------------------------------------------
# Payments — set PAYMENT_PROVIDER=dev (default) for local development.
# Supported: payfast | peach | yoco | dev
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=dev

# PayFast (https://www.payfast.co.za) — Settings > Integration in your dashboard
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Must match your deployed URL exactly (no trailing slash) — used to build
# email links and payment return/notify URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protects /api/cron/expire-holds from being called by anyone but your
# scheduler. Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Admin portal
# ---------------------------------------------------------------------------
# Minutes of inactivity on /admin/* before an admin session is force-expired
# (separate from Supabase's own JWT/refresh-token expiry). Default: 60.
ADMIN_SESSION_IDLE_MINUTES=60
